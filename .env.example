# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel > Project > Settings > Environment Variables.
# NEVER give the Stripe keys or EMAILJS_PRIVATE_KEY a VITE_ prefix: that
# would bundle them into the public site.

# Stripe > Developers > API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint page in production
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public site address, no trailing slash
SITE_URL=http://localhost:3000

# EmailJS for the browser forms. These are PUBLIC by design (EmailJS
# expects them in the browser), so the VITE_ prefix is correct here.
# Values are baked in at build time: redeploy after changing them.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Total upload size per email allowed by the EmailJS plan (Professional = 2048)
VITE_EMAILJS_ATTACHMENT_LIMIT_KB=2048

# EmailJS, for the "payment received" email sent by the webhook (server only)
EMAILJS_SERVICE_ID=
EMAILJS_PAYMENT_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
